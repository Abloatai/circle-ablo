{
   "name": "circle",
   "version": "0.4.0",
   "private": true,
   "packageManager": "pnpm@11.7.0",
   "scripts": {
      "dev": "next dev --turbopack",
      "build": "next build",
      "start": "next start",
      "lint": "next lint",
      "format": "prettier --write .",
      "prepare": "husky",
      "db:generate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
      "db:migrate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
      "db:studio": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs studio",
      "auth:generate": "better-auth generate --config lib/auth.ts --output db/schema/auth.ts --yes",
      "db:seed": "tsx --env-file=.env.local db/seed.ts && pnpm ablo:reload",
      "db:backfill": "tsx --env-file=.env.local db/backfill-ablo-tenant.ts",
      "ablo:reload": "ablo connect resnapshot --yes --env-file .env.local",
      "test": "playwright test",
      "test:e2e": "playwright test --project=e2e",
      "test:unit": "playwright test --project=unit",
      "test:ui": "playwright test --project=e2e --ui"
   },
   "dependencies": {
      "@abloatai/ablo": "^0.55.0",
      "@hookform/resolvers": "^4.1.2",
      "@kayron013/lexorank": "^2.0.0",
      "@radix-ui/react-alert-dialog": "^1.1.6",
      "@radix-ui/react-avatar": "^1.1.3",
      "@radix-ui/react-checkbox": "^1.1.4",
      "@radix-ui/react-collapsible": "^1.1.3",
      "@radix-ui/react-context-menu": "^2.2.10",
      "@radix-ui/react-dialog": "^1.1.6",
      "@radix-ui/react-dropdown-menu": "^2.1.6",
      "@radix-ui/react-label": "^2.1.2",
      "@radix-ui/react-popover": "^1.1.6",
      "@radix-ui/react-progress": "^1.1.2",
      "@radix-ui/react-select": "^2.1.6",
      "@radix-ui/react-separator": "^1.1.2",
      "@radix-ui/react-slider": "^1.4.7",
      "@radix-ui/react-slot": "^1.1.2",
      "@radix-ui/react-switch": "^1.1.3",
      "@radix-ui/react-tabs": "^1.1.3",
      "@radix-ui/react-toggle": "^1.1.2",
      "@radix-ui/react-tooltip": "^1.1.8",
      "@remixicon/react": "^4.6.0",
      "@vercel/connect": "0.4.3",
      "ai": "^7.0.58",
      "better-auth": "^1.6.29",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "cmdk": "1.0.0",
      "date-fns": "^4.1.0",
      "drizzle-orm": "^0.45.2",
      "eve": "^0.38.3",
      "lucide-react": "^0.476.0",
      "motion": "^12.4.10",
      "next": "15.2.8",
      "next-themes": "^0.4.4",
      "nuqs": "^2.9.4",
      "pg": "^8.23.0",
      "react": "^19.0.1",
      "react-day-picker": "8.10.1",
      "react-dnd": "^16.0.1",
      "react-dnd-html5-backend": "^16.0.1",
      "react-dom": "^19.0.1",
      "react-hook-form": "^7.54.2",
      "react-icons": "^5.5.0",
      "react-resizable-panels": "^3.0.3",
      "recharts": "^2.15.1",
      "resend": "^6.20.0",
      "sonner": "^2.0.1",
      "tailwind-merge": "^3.0.2",
      "tailwindcss-animate": "^1.0.7",
      "usehooks-ts": "^3.1.1",
      "uuid": "^11.1.0",
      "zod": "^4.4.3",
      "zustand": "^5.0.3"
   },
   "devDependencies": {
      "@abloatai/cli": "^0.55.0",
      "@abloatai/humans": "^0.55.0",
      "@eslint/eslintrc": "^3",
      "@playwright/test": "^1.62.1",
      "@tailwindcss/postcss": "^4",
      "@types/node": "^20",
      "@types/pg": "^8.21.0",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "drizzle-kit": "^0.31.10",
      "eslint": "^9",
      "eslint-config-next": "15.2.4",
      "eslint-config-prettier": "^10.0.2",
      "eslint-plugin-prettier": "^5.2.3",
      "husky": "^9.1.7",
      "lint-staged": "^15.4.3",
      "prettier": "^3.5.2",
      "tailwindcss": "^4",
      "tsx": "^4.23.12",
      "typescript": "^5"
   },
   "engines": {
      "node": "24.x"
   }
}

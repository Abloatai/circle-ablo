{
   "name": "circle",
   "version": "0.6.1",
   "private": true,
   "packageManager": "pnpm@12.21.0",
   "scripts": {
      "dev": "next dev --turbopack",
      "build": "next build --webpack",
      "start": "next start",
      "lint": "eslint .",
      "format": "prettier --write .",
      "prepare": "husky",
      "db:generate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
      "db:migrate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
      "db:studio": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs studio",
      "auth:generate": "better-auth generate --config lib/auth.ts --output db/schema/auth.ts --yes",
      "db:seed": "tsx --env-file=.env.local db/seed.ts && pnpm ablo:reload",
      "db:backfill": "tsx --env-file=.env.local db/backfill-ablo-tenant.ts",
      "ablo:reload": "ablo connect resnapshot --yes --env-file .env.local",
      "test": "playwright test",
      "test:e2e": "playwright test --project=e2e",
      "test:unit": "playwright test --project=unit",
      "test:ui": "playwright test --project=e2e --ui"
   },
   "dependencies": {
      "@abloatai/ablo": "0.67.3",
      "@hookform/resolvers": "^7.0.7",
      "@kayron013/lexorank": "^2.0.0",
      "@radix-ui/react-alert-dialog": "^1.2.1",
      "@radix-ui/react-avatar": "^1.3.1",
      "@radix-ui/react-checkbox": "^1.4.1",
      "@radix-ui/react-collapsible": "^1.2.1",
      "@radix-ui/react-context-menu": "^2.4.1",
      "@radix-ui/react-dialog": "^1.3.1",
      "@radix-ui/react-dropdown-menu": "^2.2.1",
      "@radix-ui/react-label": "^2.1.17",
      "@radix-ui/react-popover": "^1.3.1",
      "@radix-ui/react-progress": "^1.2.1",
      "@radix-ui/react-select": "^2.4.1",
      "@radix-ui/react-separator": "^1.2.0",
      "@radix-ui/react-slider": "^1.6.1",
      "@radix-ui/react-slot": "^1.5.0",
      "@radix-ui/react-switch": "^1.4.1",
      "@radix-ui/react-tabs": "^1.2.1",
      "@radix-ui/react-toggle": "^1.2.1",
      "@radix-ui/react-tooltip": "^1.4.1",
      "@remixicon/react": "^4.9.0",
      "@vercel/connect": "2.9.4",
      "ai": "^7.0.177",
      "better-auth": "^1.7.25",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "cmdk": "1.1.1",
      "date-fns": "^4.4.0",
      "drizzle-orm": "^0.45.4",
      "eve": "^1.1.0",
      "lucide-react": "^1.74.0",
      "motion": "^14.14.0",
      "next": "16.4.6",
      "next-themes": "^0.4.6",
      "nuqs": "^2.10.3",
      "pg": "^8.23.1",
      "react": "19.3.1",
      "react-day-picker": "10.0.2",
      "react-dnd": "^16.0.1",
      "react-dnd-html5-backend": "^16.0.1",
      "react-dom": "19.3.1",
      "react-hook-form": "^7.92.0",
      "react-icons": "^5.7.0",
      "react-resizable-panels": "^4.24.0",
      "recharts": "^3.11.0",
      "resend": "^6.38.1",
      "server-only": "0.0.1",
      "sonner": "^2.0.8",
      "streamdown": "^2.8.0",
      "tailwind-merge": "^3.7.0",
      "tailwindcss-animate": "^1.0.7",
      "usehooks-ts": "^3.1.1",
      "uuid": "^14.0.3",
      "zod": "^4.6.7",
      "zustand": "^5.1.0"
   },
   "devDependencies": {
      "@abloatai/cli": "0.67.3",
      "@abloatai/humans": "0.67.3",
      "@playwright/test": "^1.65.1",
      "@tailwindcss/postcss": "^4.3.5",
      "@types/node": "^26.6.6",
      "@types/pg": "^8.23.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "drizzle-kit": "^0.31.11",
      "eslint": "^10.15.0",
      "eslint-config-next": "16.4.6",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-prettier": "^5.5.7",
      "husky": "^9.1.7",
      "lint-staged": "^17.6.1",
      "prettier": "^3.10.1",
      "tailwindcss": "^4.3.5",
      "tsx": "^4.23.15",
      "typescript": "^6.0.3"
   },
   "engines": {
      "node": "26.x"
   }
}

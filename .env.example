# Neon — the source of truth. Logical replication must be enabled on the project.
# DATABASE_URL is the direct endpoint: migrations and DDL need a real session.
DATABASE_URL=postgres://...
# The pooled endpoint (PgBouncer). Request handlers use this one — see db/index.ts.
DATABASE_URL_POOLED=postgres://...

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Ablo — written by `npx ablo dev --branch <git-ref>` into .env.local.
# Production needs its own branch and its own key; see ROADMAP.md.
ABLO_API_KEY=

# eve agents (Vercel AI Gateway)
AI_GATEWAY_API_KEY=

# Where the agent runtime listens. Unset falls back to 127.0.0.1:2000 for
# `eve dev`; a production deployment without it refuses to dispatch rather than
# failing against a localhost that is not there.
EVE_URL=

# Shared secret between the app and the agent channel. `app/api/agent/dispatch`
# sends it, `agent/channels/eve.ts` checks it. Without it the channel has no
# authenticator for Circle's own calls and answers 401.
AGENT_CHANNEL_SECRET=

# Optional. Lets pasted pull request links resolve their real title and state.
# Without it the public GitHub API is used: 60 requests an hour per IP, public
# repositories only. With it, 5,000 an hour and private repositories too.
GITHUB_TOKEN=

# Email. Without a key, invitations log to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM=
